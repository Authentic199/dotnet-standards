@@ -0,0 +1,104 @@
+using AutoMapper;
+using AutoMapper.QueryableExtensions;
+using Core.Bases;
+using Core.Common.Exceptions;
+using Core.Common.Interfaces;
+using Infrastructure.Facades.Common.Extensions;
+using Infrastructure.Facades.Common.Responses;
+using Infrastructure.Facades.Definitions;
+using Infrastructure.Facades.Persistence.Repositories;
+using Infrastructure.Modules.Vouchers.Entities;
+using Infrastructure.Modules.Vouchers.Requests.Vouchers;
+using Infrastructure.Modules.Vouchers.Responses;
+using Microsoft.EntityFrameworkCore;
+
+namespace Infrastructure.Modules.Vouchers.Services;
+
+public interface IVoucherService : IScopedService
+{
+    Task<VoucherResponse> CreateAsync(CreateVoucherRequest request, CancellationToken cancellationToken = default);
+
+    Task<VoucherResponse> UpdateAsync(Guid voucherId, UpdateVoucherRequest request, CancellationToken cancellationToken = default);
+
+    Task<VoucherResponse> GetAsync(Guid voucherId, CancellationToken cancellationToken = default);
+
+    Task<PaginationResponse<VoucherResponse>> SearchAsync(QueryContainer request, CancellationToken cancellationToken = default);
+
+    Task<MultipleIdentiferResponse> DeleteRangeAsync(DeleteVoucherRequest request, CancellationToken cancellationToken = default);
+}
+
+public class VoucherService : IVoucherService
+{
+    private readonly IRepositoryWrapper repositoryWrapper;
+    private readonly IMapper mapper;
+
+    public VoucherService(IRepositoryWrapper repositoryWrapper, IMapper mapper)
+    {
+        this.repositoryWrapper = repositoryWrapper;
+        this.mapper = mapper;
+    }
+
+    public async Task<VoucherResponse> CreateAsync(CreateVoucherRequest request, CancellationToken cancellationToken = default)
+    {
+        string code = request.Code!.Trim();
+        await ThrowIfCodeExistsAsync(code, cancellationToken: cancellationToken);
+
+        Voucher voucher = mapper.Map<Voucher>(request);
+        voucher.Status = VoucherStatus.Active;
+        await repositoryWrapper.Repository<Voucher>().AddAsync(voucher, cancellationToken);
+        return await GetAsync(voucher.Id, cancellationToken);
+    }
+
+    public async Task<VoucherResponse> UpdateAsync(Guid voucherId, UpdateVoucherRequest request, CancellationToken cancellationToken = default)
+    {
+        Voucher voucher = await repositoryWrapper.Repository<Voucher>().GetByIdAsync(voucherId, cancellationToken)
+            ?? throw new BadRequestException(Messages<Voucher>.NotFound());
+
+        mapper.Map(request, voucher);
+        await repositoryWrapper.Repository<Voucher>().UpdateAsync(voucher, cancellationToken);
+        return await GetAsync(voucher.Id, cancellationToken);
+    }
+
+    public async Task<VoucherResponse> GetAsync(Guid voucherId, CancellationToken cancellationToken = default)
+        => await repositoryWrapper.Repository<Voucher>()
+            .Find(x => x.Id == voucherId, isAsNoTracking: true)
+            .ProjectTo<VoucherResponse>(mapper.ConfigurationProvider)
+            .FirstOrDefaultAsync(cancellationToken)
+        ?? throw new BadRequestException(Messages<Voucher>.NotFound());
+
+    public async Task<PaginationResponse<VoucherResponse>> SearchAsync(QueryContainer request, CancellationToken cancellationToken = default)
+        => await repositoryWrapper.Repository<Voucher>()
+            .Find(isAsNoTracking: true)
+            .ProjectTo<VoucherResponse>(mapper.ConfigurationProvider)
+            .ApplyFilter(request.Filter)
+            .ApplySearch(request.SearchKeyword, new[] { nameof(VoucherResponse.Name), nameof(VoucherResponse.Code) }, request.Filter?.Keys.ToArray())
+            .ApplySort($"{nameof(BaseEntity.CreatedAt)} desc", request.SortQuery)
+            .ToPagedListAsync(request.Current, request.PageSize, cancellationToken: cancellationToken);
+
+    public async Task<MultipleIdentiferResponse> DeleteRangeAsync(DeleteVoucherRequest request, CancellationToken cancellationToken = default)
+    {
+        Voucher[] vouchers = await repositoryWrapper.Repository<Voucher>()
+            .Find(x => request.Items!.Contains(x.Id))
+            .ToArrayAsync(cancellationToken);
+        if (vouchers.Length != request.Items!.Count)
+        {
+            throw new BadRequestException(Messages<Voucher>.NotFound());
+        }
+
+        await repositoryWrapper.Repository<Voucher>().DeleteRangeAsync(vouchers, cancellationToken);
+        return new(request.Items);
+    }
+
+    private async Task ThrowIfCodeExistsAsync(string code, Guid? exceptId = null, CancellationToken cancellationToken = default)
+    {
+        bool codeExists = await repositoryWrapper.Repository<Voucher>()
+            .AnyAsync(
+                x => x.Code == code
+                    && (!exceptId.HasValue || x.Id != exceptId.Value),
+                cancellationToken);
+        if (codeExists)
+        {
+            throw new BadRequestException(Messages<Voucher>.AlreadyExist(x => x.Code));
+        }
+    }
+}
