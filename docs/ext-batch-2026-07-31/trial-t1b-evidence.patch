@@ -0,0 +1,61 @@
+using Core.Bases;
+using Core.Common.Interfaces;
+using Infrastructure.Facades.Common.Extensions;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.EntityFrameworkCore.Metadata.Builders;
+
+namespace Infrastructure.Modules.Vouchers.Entities;
+
+public class Voucher : BaseEntity, ICode
+{
+    public string? Code { get; set; }
+
+    public string Name { get; set; } = default!;
+
+    public string? Description { get; set; }
+
+    public int Quantity { get; set; }
+
+    public DateTimeOffset ExpiredAt { get; set; }
+
+    public VoucherStatus Status { get; set; } = VoucherStatus.Active;
+}
+
+public enum VoucherStatus : byte
+{
+    /// <summary>
+    /// Voucher đang hoạt động và có thể sử dụng.
+    /// </summary>
+    Active = 1,
+
+    /// <summary>
+    /// Voucher đang tạm ngưng sử dụng.
+    /// </summary>
+    Inactive = 2,
+
+    /// <summary>
+    /// Voucher đã hết hạn.
+    /// </summary>
+    Expired = 3,
+}
+
+public class VoucherConfiguration : IEntityTypeConfiguration<Voucher>
+{
+    public void Configure(EntityTypeBuilder<Voucher> builder)
+    {
+        builder
+            .UnderscoreTable()
+            .HasBaseEntity()
+            .HasCode();
+
+        builder.Property(x => x.Code).HasMaxLength(100);
+        builder.Property(x => x.Name).IsRequired().HasMaxLength(250);
+        builder.Property(x => x.Description).HasMaxLength(2000);
+        builder.Property(x => x.Quantity).IsRequired();
+        builder.Property(x => x.ExpiredAt).IsRequired();
+        builder.Property(x => x.Status).IsRequired().HasDefaultValue(VoucherStatus.Active);
+
+        builder.HasIndex(x => x.Status);
+        builder.HasIndex(x => x.ExpiredAt);
+    }
+}
