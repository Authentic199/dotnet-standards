+using FluentValidation;
+using Infrastructure.Facades.Common.Extensions;
+using Infrastructure.Facades.Definitions;
+using Infrastructure.Modules.Vouchers.Requests.Vouchers;
+using System.Text.RegularExpressions;
+
+namespace Infrastructure.Modules.Vouchers.Validations.Vouchers;
+
+public class CreateVoucherRequestValidator : VoucherRequestValidator<CreateVoucherRequest>
+{
+    public CreateVoucherRequestValidator()
+    {
+        RuleFor(x => x.Code)
+            .Cascade(CascadeMode.Stop)
+            .NotEmpty().WithMessage(MessagesType.Required)
+            .Must(code => code!.Trim().Length <= 100).WithMessage(MessagesType.OverLength)
+            .Must(code => Regex.IsMatch(code!.Trim(), "^[A-Za-z0-9_-]+$"))
+            .WithMessage(MessagesType.Invalid);
+    }
+}
