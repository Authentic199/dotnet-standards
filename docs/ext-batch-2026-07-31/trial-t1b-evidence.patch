@@ -0,0 +1,24 @@
+using AutoMapper;
+using Infrastructure.Modules.Vouchers.Entities;
+
+namespace Infrastructure.Modules.Vouchers.Requests.Vouchers;
+
+public class VoucherRequestProfile : Profile
+{
+    public VoucherRequestProfile()
+    {
+        CreateMap<CreateVoucherRequest, Voucher>()
+            .ForMember(destination => destination.Code, options => options.MapFrom(source => source.Code!.Trim()))
+            .ForMember(destination => destination.Name, options => options.MapFrom(source => source.Name!.Trim()))
+            .ForMember(destination => destination.Description, options => options.MapFrom(source => NormalizeDescription(source.Description)))
+            .ForMember(destination => destination.Status, options => options.Ignore());
+
+        CreateMap<UpdateVoucherRequest, Voucher>()
+            .ForMember(destination => destination.Code, options => options.Ignore())
+            .ForMember(destination => destination.Name, options => options.MapFrom(source => source.Name!.Trim()))
+            .ForMember(destination => destination.Description, options => options.MapFrom(source => NormalizeDescription(source.Description)));
+    }
+
+    private static string? NormalizeDescription(string? description)
+        => string.IsNullOrWhiteSpace(description) ? null : description.Trim();
+}
