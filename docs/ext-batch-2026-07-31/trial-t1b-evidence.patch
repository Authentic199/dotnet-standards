+using FluentValidation;
+using Infrastructure.Facades.Common.Extensions;
+using Infrastructure.Facades.Definitions;
+using Infrastructure.Modules.Vouchers.Requests.Vouchers;
+
+namespace Infrastructure.Modules.Vouchers.Validations.Vouchers;
+
+public abstract class VoucherRequestValidator<T> : AbstractValidator<T>
+    where T : VoucherRequest
+{
+    protected VoucherRequestValidator()
+    {
+        RuleFor(x => x.Name)
+            .NotEmpty().WithMessage(MessagesType.Required)
+            .MaximumLength(250).WithMessage(MessagesType.OverLength);
+
+        RuleFor(x => x.Description)
+            .Must(description => string.IsNullOrWhiteSpace(description) || description.Trim().Length <= 2000)
+            .WithMessage(MessagesType.OverLength);
+
+        RuleFor(x => x.Quantity)
+            .GreaterThanOrEqualTo(0).WithMessage(MessagesType.Invalid);
+
+        RuleFor(x => x.ExpiredAt)
+            .NotEqual(default(DateTimeOffset)).WithMessage(MessagesType.Required);
+    }
+}
