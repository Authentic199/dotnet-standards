+using Core.Common.Exceptions;
+using Infrastructure.Facades.Auth.Jwt;
+using Infrastructure.Facades.Auth.Permissions;
+using Infrastructure.Facades.Common.Extensions;
+using Infrastructure.Facades.Common.Responses;
+using Infrastructure.Facades.Definitions;
+using Infrastructure.Modules.Vouchers.Entities;
+using Infrastructure.Modules.Vouchers.Requests.Vouchers;
+using Infrastructure.Modules.Vouchers.Responses;
+using Infrastructure.Modules.Vouchers.Services;
+using Microsoft.AspNetCore.Authorization;
+using Microsoft.AspNetCore.Mvc;
+
+namespace Web.Controllers.Vouchers;
+
+[Authorize]
+public class VouchersController : BaseController
+{
+    private readonly IVoucherService voucherService;
+
+    public VouchersController(IVoucherService voucherService)
+    {
+        this.voucherService = voucherService;
+    }
+
+    [HttpGet]
+    [HasPermission(schemes: new[] { JwtScheme.Default }, permissions: MxmResource.Vouchers + MxmAction.View)]
+    [ProducesResponseType(StatusCodes.Status200OK)]
+    [ProducesResponseType(typeof(ErrorResultWrapper), StatusCodes.Status400BadRequest)]
+    public async Task<ActionResult<SuccessResultWrapper<PaginationResponse<VoucherResponse>>>> SearchAsync([FromQuery] QueryContainer request, CancellationToken cancellation)
+        => OkWrapper(await voucherService.SearchAsync(request, cancellation), Messages<Voucher>.Search());
+
+    [HttpGet("{id:guid}")]
+    [HasPermission(schemes: new[] { JwtScheme.Default }, permissions: MxmResource.Vouchers + MxmAction.ViewDetail)]
+    [ProducesResponseType(StatusCodes.Status200OK)]
+    [ProducesResponseType(typeof(ErrorResultWrapper), StatusCodes.Status400BadRequest)]
+    public async Task<ActionResult<SuccessResultWrapper<VoucherResponse>>> GetAsync(
