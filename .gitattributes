# Hook scripts MUST keep LF endings on every platform.
#
# This machine has core.autocrlf=true, so without these rules a fresh clone gets
# CRLF and the hook dies on the first line with `$'\r': command not found`.
# run-hook.cmd is listed too: it is read by bash as well as by cmd.exe, and
# cmd.exe handles LF fine.
# Every hook script belongs on this list. `test-report-nudge` was missing from
# 0.3.44 until 2026-08-02 and its working copy had already gone CRLF — the exact
# failure the comment above describes, latent in the shipped tree. When a hook is
# added, it is added here in the same commit.
hooks/post-edit-format  text eol=lf
hooks/superpowers-check text eol=lf
hooks/router-nudge      text eol=lf
hooks/test-report-nudge text eol=lf
hooks/fleet-nudge       text eol=lf
hooks/process-handback  text eol=lf
hooks/run-hook.cmd      text eol=lf
docs/field-reports/trial-extract.py text eol=lf

# The Codex kit, for the same reason: install.sh is run by bash, and the two
# generators are compared byte for byte by `sync-from-plugin.py --check`, which
# would report permanent drift if a checkout rewrote their endings.
codex/install.sh          text eol=lf
codex/sync-from-plugin.py text eol=lf
codex/agents/*.toml       text eol=lf
codex/prompts/*.md        text eol=lf
codex/hooks.json          text eol=lf
