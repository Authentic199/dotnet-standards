#!/usr/bin/env bash
# PostToolUse(Bash) hook: after a `dotnet test` run, tell the model — once per
# session — to keep a human-readable test report current.
#
# WHY THIS EXISTS, AND HOW IT RELATES TO THE REFUSED post-test-analyze
#
# The kit's `post-test-analyze.sh` was refused in S6 as "a shell summariser of
# `dotnet test` output the model already reads in full, with more context".
# That reason still holds, and this hook is built so it keeps holding: the
# script parses NOTHING — no TRX, no console counts. What the refusal never
# addressed is the artifact the user asked for on 2026-07-31: a persistent,
# plain-language report FILE a human reads after the run ("tên user không vượt
# quá 200 ký tự — PASS"), which raw test output is not and a sed script cannot
# write. Only the model can turn test names and bodies into human sentences in
# the user's own language — so, like router-nudge, this hook nudges the model
# instead of doing the work in shell.
#
# COST
#
# It emits ONCE per CONTEXT — a marker keyed by session_id plus agent_id — and
# only after a Bash call whose command contains `dotnet test`. Every other Bash
# call costs one string match and exits 0 with no output. The emitted
# instruction is standing ("whenever a test run settles"), so repeating it per
# run would buy nothing: the injected context persists in the conversation.
#
# "ONCE PER CONTEXT", NOT "ONCE PER SESSION" — FIXED 2026-08-02
#
# The original marker was keyed by session_id alone, and that was wrong in a way
# only visible under Superpowers' subagent-driven-development. Each implementer
# there is a `general-purpose` subagent that runs its own red-green loop, so the
# FIRST `dotnet test` of the whole session usually fires inside a throwaway
# subagent context. That context consumed the session's only emit and then
# vanished — and every later run, including the coordinating session's own final
# full-suite run, got nothing. The standing instruction was handed to the one
# context with no "rest of the session" to apply it to.
#
# The payload distinguishes them: `agent_id` is present only when the hook fires
# from within a subagent and is absent on the main thread (CLI 2.1.220 schema —
# "Use this field, not agent_type, to distinguish subagent calls from main-thread
# calls"). The marker now carries it, so a subagent and the main thread each get
# their own single emit and neither starves the other.
#
# AND THE TWO CONTEXTS ARE TOLD DIFFERENT THINGS — the second half of the fix
#
# Letting a subagent write `test-report.md` is worse than letting it write
# nothing: the file is overwritten per task, so the last implementer to finish
# leaves a report that names the whole session and covers one task. A subagent is
# therefore told to put its plain-language lines in the report it hands back, and
# to leave the file alone; only the main thread, which survives to the end, owns
# the file.
#
# SILENT ABSENCE IS BENIGN — the binding rule in hooks/README.md
#
# With no bash, no session_id, no writable temp directory, or a payload this
# script cannot read, the session behaves exactly as it did before the hook
# existed: test output still appears in full, nothing guards anything, the
# only loss is the courtesy report. Under-firing is the safe direction and
# the script prefers it at every branch.
#
# THE REPORT FORMAT IS USER-APPROVED (2026-08-04) AND LIVES IN THE EMIT BELOW
#
# Any change to the wording of the emitted instruction is a report-rule change
# and needs the user's approval before it ships. As of 2026-08-04: a NEW file
# per settled run under `docs/test-report/`, never an overwrite — the
# progression between runs is the part worth keeping — and the body is fixed
# Vietnamese prose (ĐẠT/HỎNG), not "the language the user is conversing in".
#
# Usage: registered in hooks/hooks.json as
#   "${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd" test-report-nudge
# Extensionless on purpose — Claude Code on Windows prepends `bash` to any
# command containing ".sh". See hooks/README.md.

set -euo pipefail

# ---------------------------------------------------------------------------
# Read the PostToolUse payload
# ---------------------------------------------------------------------------

STDIN=""
if [[ ! -t 0 ]]; then
    STDIN=$(cat)
fi

if [[ -z "$STDIN" ]]; then
    exit 0
fi

# ---------------------------------------------------------------------------
# Gate 1 — was this Bash call a `dotnet test` run?
# ---------------------------------------------------------------------------
#
# `jq` is NOT installed in the author's environment (measured S6), so the sed
# fallback is the path that actually runs here. The sed capture stops at the
# first unescaped quote after the LAST "command" key in the payload — good
# enough for a gate whose over- and under-firing are both benign: a false
# positive plants a standing instruction a run will eventually satisfy, a
# false negative loses one courtesy report. When extraction fails entirely,
# the raw payload is matched instead (over-matching, the benign direction).

CMD=""
if command -v jq >/dev/null 2>&1; then
    CMD=$(printf '%s' "$STDIN" | jq -r '.tool_input.command // empty' 2>/dev/null) || CMD=""
fi
if [[ -z "$CMD" ]]; then
    CMD=$(printf '%s' "$STDIN" | sed -n 's/.*"command"[[:space:]]*:[[:space:]]*"\(\([^"\\]\|\\.\)*\)".*/\1/p' | head -1) || CMD=""
fi
if [[ -z "$CMD" ]]; then
    CMD="$STDIN"
fi

if ! printf '%s' "$CMD" | grep -Eq '(^|[^[:alnum:]])dotnet(\.exe)?[[:space:]]+test([^[:alnum:]]|$)'; then
    exit 0
fi

# ---------------------------------------------------------------------------
# Gate 2 — emit once per session
# ---------------------------------------------------------------------------
#
# Same mechanism as router-nudge: no session id means no way to tell the first
# test run from the fortieth, and the standing instruction makes repetition
# worthless — so under-fire, never over-fire.

json_string_field() {
    local key="$1" out=""
    if command -v jq >/dev/null 2>&1; then
        out=$(printf '%s' "$STDIN" | jq -r --arg k "$key" '.[$k] // empty' 2>/dev/null) || out=""
    fi
    if [[ -z "$out" ]]; then
        out=$(printf '%s' "$STDIN" | sed -n "s/.*\"$key\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" | head -1) || out=""
        out="${out//\\\\/\\}"
    fi
    printf '%s' "$out"
}

SESSION_ID=$(json_string_field session_id)

if [[ -z "$SESSION_ID" ]]; then
    exit 0
fi

# Present ONLY inside a subagent; absent on the main thread. A CLI that does not
# send it at all degrades to the pre-2026-08-02 behaviour — one emit per session,
# to whichever context got there first — which is the direction that was already
# shipping, so an unknown CLI loses nothing it had.
AGENT_ID=$(json_string_field agent_id)

STATE_DIR="${TMPDIR:-/tmp}/dotnet-standards"
if ! mkdir -p "$STATE_DIR" 2>/dev/null; then
    exit 0
fi

SAFE_ID=$(printf '%s' "$SESSION_ID" | tr -c 'A-Za-z0-9._-' '_')
MARKER="$STATE_DIR/test-report-nudge-$SAFE_ID"

if [[ -n "$AGENT_ID" ]]; then
    SAFE_AGENT=$(printf '%s' "$AGENT_ID" | tr -c 'A-Za-z0-9._-' '_')
    MARKER="$STATE_DIR/test-report-nudge-$SAFE_ID-agent-$SAFE_AGENT"
fi

if [[ -e "$MARKER" ]]; then
    exit 0
fi

if ! : > "$MARKER" 2>/dev/null; then
    exit 0
fi

# Sweep week-old markers so the directory cannot grow without bound. Runs at
# most once per session, on the call that already paid for the emit.
find "$STATE_DIR" -maxdepth 1 -type f -name 'test-report-nudge-*' -mtime +7 -delete 2>/dev/null || true

# ---------------------------------------------------------------------------
# Emit — the main-thread report rule is user-approved wording (2026-08-04) and
# is reproduced below UNCHANGED, to the character. The subagent branch does
# not restate the format: it deliberately hands the file to the one context
# that owns it and asks the subagent for sentences instead.
# ---------------------------------------------------------------------------

if [[ -n "$AGENT_ID" ]]; then
cat <<'JSON'
{
  "hookSpecificOutput": {
    "hookEventName": "PostToolUse",
    "additionalContext": "A `dotnet test` run has just completed inside a subagent. Do NOT write or overwrite any file under `docs/test-report/` — that belongs to the session that dispatched you, and a subagent writing one leaves an orphaned file naming only this task. Instead, when your tests settle, include in the report you hand back: the exact command and the pass/fail/skip totals, then one line per test case stating in Vietnamese what the test verifies — derived from the test's name and body, e.g. 'Tên người dùng không được vượt quá 200 ký tự — ĐẠT' — marked ĐẠT or HỎNG, each HỎNG carrying one short reason. Emitted once per subagent."
  }
}
JSON
    exit 0
fi

cat <<'JSON'
{
  "hookSpecificOutput": {
    "hookEventName": "PostToolUse",
    "additionalContext": "A `dotnet test` run has just completed. Standing instruction for the rest of this session: whenever a test run settles (after the final run of a red-green loop — not between iterations), write a NEW report file at `docs/test-report/YYYY-MM-DD-test-<what-was-tested>.md` (today's date, and a short kebab-case slug you choose describing what was tested) — never overwrite an earlier file, because the progression between runs is the part worth keeping. User-approved format, in Vietnamese prose: the exact command and the pass/fail/skip totals, then one section per test class; under each, one plain line per test case stating in Vietnamese what the test verifies — derived from the test's name and body, e.g. 'Tên người dùng không được vượt quá 200 ký tự — ĐẠT' — marked ĐẠT or HỎNG, each HỎNG carrying one short reason. Short and human-readable: no jargon, no filler, no explanations beyond the one-line HỎNG reasons. Where subagents ran tests, fold the lines they reported back into this file rather than re-deriving them. Emitted once per session."
  }
}
JSON

exit 0
